{
  "name": "precog-trend-radar",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "A personal situation room: pick a channel, get the gist. Tracks topics, never people.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run typecheck && npm run format:check",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "date-fns": "4.4.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.15.21",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "happy-dom": "15.11.7",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "vite-plugin-singlefile": "2.2.0",
    "vitest": "5.1.0",
    "vue-tsc": "2.2.10"
  }
}
