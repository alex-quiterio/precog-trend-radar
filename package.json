{
  "name": "precog-trend-radar",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "A personal situation room: pick a channel, get the gist. Tracks topics, never people.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run typecheck && npm run eslint && npm run format:check",
    "test:e2e": "playwright test",
    "eslint": "eslint ."
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "date-fns": "4.4.0",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.1",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
