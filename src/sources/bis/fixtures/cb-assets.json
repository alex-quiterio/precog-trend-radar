            "values": [
              {
                "id": "From 1998 onwards: consolidated financial statements of the Eurosystem, including the balance sheets of the European Central Bank and Eurosystem central banks, including all national central banks branches, vis-\u00e0-vis third parties.",
                "name": "From 1998 onwards: consolidated financial statements of the Eurosystem, including the balance sheets of the European Central Bank and Eurosystem central banks, including all national central banks branches, vis-\u00e0-vis third parties."
              },
              {
                "id": "From January 2002 onwards: monthly balance sheet of the People's Bank of China. Between 1993 and 2001: sum of foreign assets (net), claims against the government, bank claims on deposit money, claims against non-monetary financial institutions and claims on the non-financial sector. Before 2000: Almanac of China's finance and banking.",
                "name": "From January 2002 onwards: monthly balance sheet of the People's Bank of China. Between 1993 and 2001: sum of foreign assets (net), claims against the government, bank claims on deposit money, claims against non-monetary financial institutions and claims on the non-financial sector. Before 2000: Almanac of China's finance and banking."
              },
              {
                "id": "From January 1953 onwards: end-of-month balance for total assets following the methodological specifications of the Bank of Japan Accounts. Before 1953: end-of-year balance for total assets as shown in 'Meiji iko hompo shuyo keizai tokei [Hundred-year statistics of the Japanese economy] (edition 1966)'.",
                "name": "From January 1953 onwards: end-of-month balance for total assets following the methodological specifications of the Bank of Japan Accounts. Before 1953: end-of-year balance for total assets as shown in 'Meiji iko hompo shuyo keizai tokei [Hundred-year statistics of the Japanese economy] (edition 1966)'."
              },
              {
                "id": "From March 1989 onwards: Factors Affecting Reserve Balances (H.4.1). Between November 1914 and March 1989: Bao et al (2018): 'The Federal Reserve System's weekly balance sheet since 1914'.",
                "name": "From March 1989 onwards: Factors Affecting Reserve Balances (H.4.1). Between November 1914 and March 1989: Bao et al (2018): 'The Federal Reserve System's weekly balance sheet since 1914'."
